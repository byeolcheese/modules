#!name=VVebo Timeline Diagnostic
#!desc=诊断自己微博时间线；不会在日志打印 UID 或账号凭证
#!homepage=https://github.com/byeolcheese/modules

[Script]
vvebo_uid_capture = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?,script-path=https://raw.githubusercontent.com/byeolcheese/modules/main/vvebo/vvebo-fix-diagnostic.js,requires-body=0,timeout=10
vvebo_user_show = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/users\/show\?,script-path=https://raw.githubusercontent.com/byeolcheese/modules/main/vvebo/vvebo-fix-diagnostic.js,requires-body=0,timeout=10
vvebo_timeline_request = type=http-request,pattern=^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?,script-path=https://raw.githubusercontent.com/byeolcheese/modules/main/vvebo/vvebo-fix-diagnostic.js,requires-body=0,timeout=10
vvebo_timeline_response = type=http-response,pattern=^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?,script-path=https://raw.githubusercontent.com/byeolcheese/modules/main/vvebo/vvebo-fix-diagnostic.js,requires-body=1,timeout=10

[MITM]
hostname = %APPEND% api.weibo.cn
